{
  "expo": {
    "name": "portl",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "splash": {
      "image": "./assets/images/get-start-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FAF9F5"
    },
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.veerukry.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veerukry.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon_io/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F5",
          "image": "./assets/images/get-start-splash.png",
          "resizeMode": "cover",
          "android": {
            "image": "./assets/images/get-start-splash.png",
            "resizeMode": "cover"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
