{
  "expo": {
    "name": "PortL",
    "slug": "portl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F5"
    },
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pankajkry.portl"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pankajkry.portl",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon_io/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F5",
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/logo.png",
            "resizeMode": "contain"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PortL to scan visitor QR codes",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74ade280-afa9-43ec-8921-5df86b03d2f7"
      }
    }
  }
}
